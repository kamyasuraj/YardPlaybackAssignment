# Repo-root ignores.
# The Unity project has its own canonical .gitignore in YardPlayback/.gitignore.

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp

# WebGL: Build/ (the four files next to index.html) is committed so the page runs from GitHub Pages.
# Stage a rebuild outside the repo; Builds/ stays ignored in case one is staged here by hand.
/[Bb]uilds/

# Logs
*.log
